# Public canonical URL used for metadata, redirects, and local development.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase application access. Leave all three Supabase values unset for local
# dual-mode storage in .data/store.json.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional explicit Supabase URL used by `npm run db:seed`; it defaults to
# NEXT_PUBLIC_SUPABASE_URL when omitted.
SUPABASE_URL=

# Optional Resend transactional email delivery. Without these values, email is
# logged/no-op locally so inquiry development still works.
RESEND_API_KEY=
EMAIL_FROM="Atelier Graded <hello@example.com>"

# Optional operations inbox for new inquiry notifications.
ADMIN_EMAIL=

# Optional Supabase administrator provisioned by `npm run db:seed`. Set both
# values together; passwords must contain at least 12 characters.
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=

# Checkout is intentionally disabled while sales are handled through inquiries.
DIRECT_CHECKOUT_ENABLED=false
# Reserved for a future direct checkout integration; it has no effect while
# DIRECT_CHECKOUT_ENABLED=false.
STRIPE_SECRET_KEY=

# Optional server-side secret for the bot-protection adapter.
BOT_PROTECTION_SECRET=

# Local demo accounts (available without Supabase):
# admin@ateliergraded.demo / ChangeMeAdmin!23
# collector@ateliergraded.demo / ChangeMeUser!23
